{
  "name": "sistema-estoque-construtora",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "prisma": {
      "mysql2": "3.24.4",
      "@prisma/config": {
        "deepmerge-ts": "8.0.2"
      }
    }
  },
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev --workspace @estoque/api\" \"npm run dev:web\"",
    "dev:web": "node scripts/wait-for-api.mjs && npm run dev --workspace @estoque/web",
    "setup": "node scripts/setup.mjs",
    "start:local": "npm run setup && npm run services:up && npm run db:generate && npm run db:migrate && npm run dev",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs --verify",
    "db:generate": "npm run generate --workspace @estoque/database",
    "db:migrate": "npm run migrate --workspace @estoque/database",
    "services:up": "docker compose up -d --wait",
    "build": "npm run typecheck && npm run build --workspace @estoque/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env scripts/test-database.mjs --e2e",
    "test:integration": "node --env-file=.env scripts/test-database.mjs",
    "lint": "eslint .",
    "format": "prettier --write apps packages tests scripts .github *.json *.js *.ts *.yml",
    "format:check": "prettier --check apps packages tests scripts .github *.json *.js *.ts *.yml"
  },
  "devDependencies": {
    "vite": "7.3.6",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
